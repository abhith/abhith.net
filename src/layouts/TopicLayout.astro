---
/**
 * Topic hub shell: header with per-type counts and editor-like tabs for
 * overview · stories · videos · tools (tabs only link to pages that exist).
 */
import { existsSync } from "node:fs";
import { join } from "node:path";
import type { TopicSummary } from "@/lib/graph/types";
import { topicHue } from "@/lib/graph/color";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  topic: TopicSummary;
  active: "overview" | "stories" | "videos" | "tools";
  title?: string;
  description?: string;
}

const { topic, active, title, description } = Astro.props;
const base = `/topics/${topic.slug}/`;
/** Some topics.yml entries reference logos that were never added to static/img/topics. */
const logo = topic.image && existsSync(join(process.cwd(), "public/img/topics", topic.image)) ? `/img/topics/${topic.image}` : undefined;
const tabs = [
  { key: "overview", label: `${topic.slug}.md`, href: base, count: topic.totalPosts + topic.totalSnippets, show: true },
  { key: "stories", label: "stories/", href: `${base}stories/`, count: topic.totalStories, show: topic.totalStories > 0 },
  { key: "videos", label: "videos/", href: `${base}videos/`, count: topic.totalVideos, show: topic.totalVideos > 0 },
  { key: "tools", label: "tools/", href: `${base}tools/`, count: topic.totalServices, show: topic.totalServices > 0 },
].filter((tab) => tab.show);

const crumbs = [{ label: "topics/", href: "/topics/" }, ...(active === "overview" ? [{ label: `${topic.slug}/` }] : [{ label: `${topic.slug}/`, href: base }, { label: `${active}/` }])];
const stats = [
  ["posts", topic.totalPosts],
  ["snippets", topic.totalSnippets],
  ["stories", topic.totalStories],
  ["videos", topic.totalVideos],
  ["tools", topic.totalServices],
] as const;
---

<BaseLayout
  title={title ?? topic.title}
  description={description ?? topic.description ?? `Posts, snippets, stories, videos and tools about ${topic.title}.`}
  image={`/og/topics/${topic.slug}.png`}
  crumbs={crumbs}
  section="topics"
>
  <div class="shell pt-8" style={`--h: ${topicHue(topic.slug)}`}>
    <header class="topic-header">
      {logo && <img src={logo} alt="" width="72" height="72" class="topic-logo" loading="eager" />}
      <div class="min-w-0">
        <p class="mono-label"><span class="topic-hash">#</span>{topic.slug}</p>
        <h1 class="mt-1 text-4xl font-bold tracking-tight sm:text-5xl">{title ?? topic.title}</h1>
        {topic.description && <p class="mt-3 max-w-3xl font-serif text-lg text-muted">{topic.description}</p>}
        <dl class="stats mt-4">
          {
            stats.map(([label, value]) => (
              <div class:list={["stat", { "stat--zero": value === 0 }]}>
                <dt>{label}</dt>
                <dd>{value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </header>

    <nav class="topic-tabs mt-8" aria-label={`${topic.title} sections`}>
      {
        tabs.map((tab) => (
          <a href={tab.href} class:list={["topic-tab", { "is-active": tab.key === active }]} aria-current={tab.key === active ? "page" : undefined}>
            {tab.label} <span class="tab-count">{tab.count}</span>
          </a>
        ))
      }
    </nav>

    <div class="pt-8">
      <slot />
    </div>
  </div>
</BaseLayout>

<style>
  .topic-header {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }
  .topic-logo {
    width: 4.5rem;
    height: 4.5rem;
    object-fit: contain;
    padding: 0.6rem;
    border: 1px solid var(--line);
    border-radius: 0.9rem;
    background: var(--surface);
    flex-shrink: 0;
  }
  .topic-hash {
    color: hsl(var(--h) var(--tag-s) var(--tag-l));
  }
  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .stat {
    display: inline-flex;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
  }
  .stat dt {
    color: var(--muted);
  }
  .stat--zero {
    opacity: 0.5;
  }
  .topic-tabs {
    display: flex;
    overflow-x: auto;
    border-bottom: 1px solid var(--line);
  }
  .topic-tab {
    position: relative;
    padding: 0.55rem 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
    border: 1px solid transparent;
    border-bottom: 0;
    border-radius: 0.4rem 0.4rem 0 0;
  }
  .topic-tab:hover {
    color: var(--fg);
    background: var(--sunken);
  }
  .topic-tab.is-active {
    color: var(--fg);
    background: var(--surface);
    border-color: var(--line);
    margin-bottom: -1px;
  }
  .topic-tab.is-active::before {
    content: "";
    position: absolute;
    inset: -1px 0 auto 0;
    height: 2px;
    background: hsl(var(--h) var(--tag-s) var(--tag-l));
    border-radius: 2px;
  }
  .tab-count {
    color: var(--muted);
    margin-left: 0.25rem;
  }
</style>
