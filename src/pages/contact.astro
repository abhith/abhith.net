---
import hello from "@/assets/abhith-garden.jpg";
import PhotoWindow from "@/components/content/PhotoWindow.astro";
import { Content, frontmatter } from "@/content/pages/contact.md";
import PageLayout from "@/layouts/PageLayout.astro";

/**
 * Forminit (formerly Getform) public form. Field names follow Forminit's form blocks
 * (`fi-sender-*`, `fi-text-*`); `_gotcha` is its honeypot. The script below does what their 2 KB SDK
 * does — POST the FormData with fetch, plus any UTM tags — without loading a third-party script.
 * Without JavaScript the browser simply posts the form to the same endpoint.
 * FORM_ID is the Forminit-native form (the legacy Getform one was deleted); keep it in "Public" mode.
 */
const FORM_ID = "fl8eq9ldb9j";
const FORM_ACTION = `https://forminit.com/f/${FORM_ID}`;
---

<PageLayout title={frontmatter.title} description={frontmatter.description} file="contact.md">
  <PhotoWindow
    src={hello}
    alt="Abhith Rajan in a white textured T-shirt with sunglasses hooked on the collar, taking a selfie in a leafy garden"
    file="~/photos/hello.jpg"
    icon="👋"
    caption="Say hi · 2025"
    tilt={-2}
  />
  <Content />

  <form slot="after" class="commit-form window mt-10" action={FORM_ACTION} method="POST" data-forminit>
    <div class="window-bar">
      <span class="window-dots" aria-hidden="true"><span></span><span></span><span></span></span>
      <span>COMMIT_EDITMSG</span>
    </div>
    <div class="grid gap-4 p-5">
      <p class="mono-label"># Please enter the message for your greeting. Lines starting with '#' are ignored.</p>
      <label class="field">
        <span class="field-label">--name</span>
        <input type="text" name="fi-sender-fullName" required autocomplete="name" placeholder="Ada Lovelace" />
      </label>
      <label class="field">
        <span class="field-label">--email</span>
        <input type="email" name="fi-sender-email" required autocomplete="email" placeholder="ada@example.com" />
      </label>
      <label class="field">
        <span class="field-label">message</span>
        <textarea name="fi-text-message" rows="6" required placeholder="Hi Abhith 👋"></textarea>
      </label>
      <!-- Honeypot: humans never see or fill this field. -->
      <input type="hidden" name="_gotcha" style="display:none !important" />
      <div class="flex flex-wrap items-center justify-between gap-3">
        <span class="mono-label">:wq to send</span>
        <button type="submit" class="btn btn-primary" data-forminit-submit>git push origin greetings</button>
      </div>
      <pre class="push-log" data-forminit-log role="status" aria-live="polite" hidden></pre>
    </div>
  </form>
</PageLayout>

<script>
  const UTM_KEYS = { utm_source: "utmSource", utm_medium: "utmMedium", utm_campaign: "utmCampaign", utm_term: "utmTerm", utm_content: "utmContent" };

  const print = (log: HTMLElement, lines: string[], state: "busy" | "ok" | "error") => {
    log.hidden = false;
    log.dataset.state = state;
    log.textContent = lines.join("\n");
  };

  // Delegated so it keeps working across client-side navigations.
  document.addEventListener("submit", async (event) => {
    const form = event.target;
    if (!(form instanceof HTMLFormElement) || !form.matches("[data-forminit]")) return;
    event.preventDefault();

    const log = form.querySelector<HTMLElement>("[data-forminit-log]")!;
    const button = form.querySelector<HTMLButtonElement>("[data-forminit-submit]")!;
    const data = new FormData(form);
    const query = new URLSearchParams(window.location.search);
    for (const [param, property] of Object.entries(UTM_KEYS)) {
      const value = query.get(param);
      if (value) data.append(`fi-tracking-${property}`, value);
    }

    button.disabled = true;
    print(log, ["Enumerating objects: 3, done.", "Writing objects: 100% (3/3), done."], "busy");

    try {
      const response = await fetch(form.action, { method: "POST", headers: { Accept: "application/json" }, body: data });
      if (!response.ok) {
        const body = await response.json().catch(() => ({}));
        throw new Error(body.message || `HTTP ${response.status}`);
      }
      form.reset();
      print(log, ["To forminit.com:abhith/inbox.git", " * [new branch]      greetings -> greetings", "", "✓ Delivered. I usually reply within a few days."], "ok");
    } catch (error) {
      const reason = error instanceof Error ? error.message : "unknown error";
      print(log, [`error: failed to push some refs (${reason})`, "hint: try again in a minute, or email abhith@pm.me instead."], "error");
    } finally {
      button.disabled = false;
    }
  });
</script>

<style>
  .field {
    display: grid;
    gap: 0.35rem;
  }
  .field-label {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent);
  }
  .field input,
  .field textarea {
    font: inherit;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--fg);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 0.375rem;
    padding: 0.6rem 0.75rem;
  }
  .field input:focus,
  .field textarea:focus {
    border-color: var(--accent);
    outline: none;
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--accent) 20%, transparent);
  }
  .push-log {
    margin: 0;
    padding: 0.75rem 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.6;
    white-space: pre-wrap;
    color: var(--muted);
    background: var(--sunken);
    border: 1px solid var(--line);
    border-radius: 0.375rem;
  }
  .push-log[data-state="ok"] {
    color: var(--fg);
    border-color: var(--accent);
  }
  .push-log[data-state="error"] {
    color: var(--warm);
  }
  [data-forminit-submit]:disabled {
    opacity: 0.6;
    cursor: progress;
  }
</style>
