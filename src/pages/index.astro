---
import { Image } from "astro:assets";
import portrait from "@/assets/abhith-dubai-airshow.jpg";
import LangGlyph from "@/components/content/LangGlyph.astro";
import PostRow from "@/components/content/PostRow.astro";
import StoryItem from "@/components/content/StoryItem.astro";
import TopicToken from "@/components/content/TopicToken.astro";
import VideoItem from "@/components/content/VideoItem.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { MONTH_INITIALS, writingActivity } from "@/lib/activity";
import { yearsCoding } from "@/lib/career";
import { getContentGraph } from "@/lib/content-graph";
import { hostOf, isoDate, plural, shortDate } from "@/lib/format";
import { topicHue } from "@/lib/graph/color";
import { withRef } from "@/lib/outbound";
import { NOW } from "@/lib/now";
import { elementGroup, elementSymbols, shortToolName } from "@/lib/periodic";
import { SITE } from "@/lib/site";

const graph = await getContentGraph();
const latestPosts = graph.posts.slice(0, 8);
const snippets = graph.snippets.slice(0, 6);
const stories = graph.stories.slice(0, 5);
const videos = graph.videos.slice(0, 3);

/**
 * The periodic table of tools: cells (column, row) of a 12-column periodic-table silhouette. The
 * gap in rows 1–3 (columns 3–7) holds the key card; below `lg` the cells simply flow.
 */
const PERIODIC_CELLS: Array<[number, number]> = [
  [1, 1],
  [12, 1],
  ...[1, 2, 8, 9, 10, 11, 12].map((col): [number, number] => [col, 2]),
  ...[1, 2, 8, 9, 10, 11, 12].map((col): [number, number] => [col, 3]),
  ...Array.from({ length: 12 }, (_, i): [number, number] => [i + 1, 4]),
];
const hasCellar = graph.tools.length > PERIODIC_CELLS.length;
// Atomic number = the order a tool was added, so the newest one closes the table like element 118.
const shownTools = graph.tools.slice(0, hasCellar ? PERIODIC_CELLS.length - 1 : PERIODIC_CELLS.length).reverse();
const cellarCount = graph.tools.length - shownTools.length;
const elementNames = shownTools.map((tool) => shortToolName(tool.title));
const symbols = elementSymbols(elementNames);
const elements = shownTools.map((tool, index) => {
  const group = elementGroup(tool.topics);
  const [col, row] = PERIODIC_CELLS[index + (hasCellar ? 1 : 0)];
  return {
    col,
    row,
    href: withRef(tool.url, { campaign: "recommended-tools" }),
    data: {
      number: String(cellarCount + index + 1),
      symbol: symbols[index],
      name: elementNames[index],
      title: tool.title,
      description: tool.description,
      host: hostOf(tool.url),
      group,
      hue: String(topicHue(group)),
      added: shortDate(tool.date),
      year: String(tool.date.getUTCFullYear()),
    },
  };
});
const newest = elements.at(-1);
const elementGroups = [...new Set(elements.map((element) => element.data.group))]
  .map((slug) => ({ slug, count: elements.filter((element) => element.data.group === slug).length }))
  .sort((a, b) => b.count - a.count || a.slug.localeCompare(b.slug));
const firstToolYear = Math.min(...graph.tools.map((tool) => tool.date.getUTCFullYear()));
const topTopics = [...graph.topics].sort((a, b) => b.totalPosts + b.totalSnippets - (a.totalPosts + a.totalSnippets)).slice(0, 14);
const { nodes, links } = graph.graphData();

/** Hero heatmap: every post and snippet as a commit, one row per year since the first one; saved links are starred dots. */
const written = [...graph.posts, ...graph.snippets].filter((entry) => !entry.draft);
const starred = [...graph.stories, ...graph.videos, ...graph.tools];
const activity = writingActivity(
  written.map((entry) => entry.date),
  new Date(),
  starred.map((item) => item.date),
);
const starredShown = activity.reduce((sum, year) => sum + year.starred, 0);
/** Proof of life next to the "now" line: the newest link saved to /recommended. */
const lastSaved = starred.reduce<Date | undefined>((latest, item) => (!latest || item.date > latest ? item.date : latest), undefined);
const monthHint = (count: number, stars: number) => [plural(count, "commit"), stars > 0 && `${stars} starred`].filter(Boolean).join(" · ");
const firstYear = activity.at(-1)?.year;
const busiestYear = [...activity].sort((a, b) => b.total - a.total)[0];
const headPost = graph.posts.find((post) => !post.draft);
const monthKey = (year: number, month: number) => `${year}-${String(month + 1).padStart(2, "0")}`;
const monthName = (year: number, month: number) =>
  new Date(Date.UTC(year, month, 1)).toLocaleDateString("en-US", { month: "short", year: "numeric", timeZone: "UTC" });

const intro = `${yearsCoding()}+ years shipping production software — .NET back ends, TypeScript front ends in React, Angular and Vue, Azure infrastructure and the pipelines in between. I build it, run it, and write about it.`;
const dirs = [
  { href: "/blog/", label: "blog/", count: graph.posts.length },
  { href: "/snippets/", label: "snippets/", count: graph.snippets.length },
  { href: "/topics/", label: "topics/", count: graph.topics.length },
  { href: "/recommended/", label: "recommended/", count: graph.stories.length + graph.videos.length + graph.tools.length },
  { href: "/graph/", label: "graph.json", count: nodes.length },
];
---

<BaseLayout crumbs={false} section="main" description={SITE.description}>
  <section class="shell grid items-center gap-10 pt-12 pb-16 lg:grid-cols-[1.1fr_1fr]" aria-labelledby="hero-title">
    <div>
      <p class="mono-label">Full-stack Software Engineer · .NET · TypeScript · Azure · Dubai</p>
      <h1 id="hero-title" class="mt-3 text-5xl font-bold tracking-tight sm:text-6xl">
        Abhith Rajan<span class="text-accent">.</span>
      </h1>
      <p class="mt-5 max-w-xl font-serif text-xl leading-relaxed text-muted">
        Notes, snippets and curated links from a working software engineer — written in the open since 2017.
      </p>
      <p class="now-line">
        <span class="now-dot" aria-hidden="true"></span>
        <span><span class="text-accent">now:</span> {NOW.doing}</span>
        <span class="now-meta">
          updated {NOW.updated}{lastSaved && <> · <a href="/recommended/" data-peek={`cd ~/recommended  # newest link saved ${isoDate(lastSaved)}`}>last link saved {isoDate(lastSaved)}</a></>}
        </span>
      </p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a href="/blog/" class="btn btn-primary">cd ~/blog</a>
        <button type="button" class="btn" data-palette-open data-peek="help  # try: cd topics/azure, grep docker, random">
          <span aria-hidden="true">›_</span> press <kbd class="kbd">⌘K</kbd>
        </button>
      </div>

      {
        activity.length > 0 && (
          <figure class="hero-log">
            <figcaption class="hero-log-head">
              <span>
                <span class="prompt">$</span>git log --since={firstYear} --heatmap
              </span>
              <span class="text-muted">
                {plural(written.length, "commit")}
                {starredShown > 0 && <span class="heat-star-count">· ★ {starredShown}</span>}
              </span>
            </figcaption>
            <div
              class="heat"
              role="img"
              aria-label={`Writing activity: ${written.length} posts and snippets since ${firstYear}, busiest year ${busiestYear?.year} with ${busiestYear?.total}.${starredShown > 0 ? ` Dots mark months with links saved to recommended, ${starredShown} in all.` : ""}`}
            >
              <span />
              {MONTH_INITIALS.map((initial) => (
                <span class="heat-month">{initial}</span>
              ))}
              <span />
              {activity.map((year, row) => (
                <>
                  <span class="heat-year">{year.year}</span>
                  {year.months.map((month) => (
                    <span
                      class="heat-cell"
                      data-level={month.level}
                      data-future={month.future ? "" : undefined}
                      data-starred={month.starred > 0 ? "" : undefined}
                      style={`--i: ${row * 12 + month.month}`}
                      title={month.future ? undefined : `${monthName(year.year, month.month)} · ${monthHint(month.count, month.starred)}`}
                      data-peek={month.future ? undefined : `git log --since=${monthKey(year.year, month.month)}  # ${monthName(year.year, month.month)} · ${monthHint(month.count, month.starred)}`}
                    />
                  ))}
                  <span class="heat-total">{year.total || "·"}</span>
                </>
              ))}
            </div>
            <div class="heat-foot">
              {headPost && (
                <a href={headPost.url} class="heat-head">
                  <span class="heat-head-ref">HEAD → main</span>
                  <span class="heat-head-title">{headPost.title}</span>
                </a>
              )}
              <span class="heat-legend" aria-hidden="true">
                less
                {[0, 1, 2, 3, 4].map((level) => (
                  <span class="heat-cell" data-level={level} />
                ))}
                more
                {starredShown > 0 && (
                  <span class="heat-legend-star">
                    <span class="heat-cell" data-level="0" data-starred />
                    starred
                  </span>
                )}
              </span>
            </div>
          </figure>
        )
      }
    </div>

    <div class="hero-desk">
      <figure class="window photo-window">
        <div class="window-bar">
          <span class="window-dots" aria-hidden="true"><span></span><span></span><span></span></span>
          <span>~/photos/me.jpg</span>
        </div>
        <div class="photo-frame">
          <Image
            src={portrait}
            alt="Abhith Rajan in a blue suit, standing in front of an Airbus A400M at the Dubai Airshow"
            widths={[320, 480, 640, 960]}
            sizes="(min-width: 1024px) 20rem, (min-width: 640px) 60vw, 70vw"
            loading="eager"
            fetchpriority="high"
            class="photo"
          />
          <figcaption class="photo-tag"><span aria-hidden="true">📍</span> Dubai Airshow · 2023</figcaption>
        </div>
      </figure>

      <div class="window terminal" role="group" aria-label="Terminal introduction">
        <div class="window-bar">
          <span class="window-dots" aria-hidden="true"><span></span><span></span><span></span></span>
          <span>abhith@workspace: ~</span>
        </div>
        <div class="terminal-body">
          <p class="line"><span class="prompt">$</span> <span class="typed" style="--chars: 6">whoami</span></p>
          <p class="out out-1">Abhith Rajan — full-stack software engineer · .NET, TypeScript &amp; Azure</p>
          <p class="line line-2"><span class="prompt">$</span> <span class="typed" style="--chars: 13">cat about.txt</span></p>
          <p class="out out-2">{intro}</p>
          <p class="line line-3"><span class="prompt">$</span> <span class="typed" style="--chars: 5">ls ~/</span></p>
          <ul class="out out-3 ls-grid">
            {
              dirs.map((dir) => (
                <li>
                  <a href={dir.href}>{dir.label}</a>
                  <span class="text-muted"> {dir.count}</span>
                </li>
              ))
            }
          </ul>
          <p class="line line-4"><span class="prompt">$</span> <span class="cursor" aria-hidden="true"></span></p>
        </div>
      </div>
    </div>
  </section>

  <section class="shell pb-16" aria-labelledby="latest-title">
    <div class="flex items-baseline justify-between">
      <h2 id="latest-title" class="section-title flex-1">git log --oneline blog</h2>
    </div>
    <ul>
      {latestPosts.map((post) => <PostRow url={post.url} title={post.title} date={post.date} topics={post.topics} description={post.description} draft={post.draft} />)}
    </ul>
    <p class="mt-4 text-right font-mono text-sm"><a href="/blog/" class="text-accent hover:underline">all {graph.posts.length} posts →</a></p>
  </section>

  <section class="shell pb-16" aria-labelledby="snippets-title">
    <h2 id="snippets-title" class="section-title">scratchpad · snippets</h2>
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        snippets.map((snippet) => (
          <li class="scratch">
            <a href={snippet.url} class="scratch-link">
              <span class="mono-label scratch-path">
                <LangGlyph language={snippet.language} link={false} />
                {snippet.category}/{snippet.slug}.mdx
              </span>
              <span class="scratch-title">{snippet.title}</span>
              <span class="scratch-desc">{snippet.description}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="mt-4 text-right font-mono text-sm"><a href="/snippets/" class="text-accent hover:underline">open scratchpad →</a></p>
  </section>

  <section class="shell grid gap-12 pb-16 lg:grid-cols-[1.2fr_1fr]">
    <div aria-labelledby="stories-title">
      <h2 id="stories-title" class="section-title">curated · stories</h2>
      <ul>
        {stories.map((story) => <StoryItem url={story.url} title={story.title} date={story.date} description={story.description} topics={story.topics} />)}
      </ul>
      <p class="mt-4 font-mono text-sm"><a href="/recommended/stories/" class="text-accent hover:underline">more stories →</a></p>
    </div>
    <div aria-labelledby="videos-title">
      <h2 id="videos-title" class="section-title">curated · videos</h2>
      <ul class="grid gap-6">
        {videos.map((video) => <VideoItem url={video.url} title={video.title} date={video.date} youtubeId={video.youtubeId} image={video.image} compact />)}
      </ul>
      <p class="mt-4 font-mono text-sm"><a href="/recommended/videos/" class="text-accent hover:underline">more videos →</a></p>
    </div>
  </section>

  {
    newest && (
      <section class="shell pb-16" aria-labelledby="toolbox-title" data-periodic>
        <h2 id="toolbox-title" class="section-title">toolbox · the periodic table of tools</h2>
        <div class="periodic">
          <div class="el-key" style={`--h: ${newest.data.hue}`} data-element-key>
            <p class="mono-label">key · atomic no. = order added · hover an element</p>
            <div class="el-key-body">
              <div class="el-face el-key-tile" aria-hidden="true">
                <span class="el-num" data-key="number">{newest.data.number}</span>
                <span class="el-year" data-key="year">{newest.data.year}</span>
                <span class="el-sym" data-key="symbol">{newest.data.symbol}</span>
                <span class="el-name" data-key="name">{newest.data.name}</span>
              </div>
              <div class="el-key-info">
                <p class="el-key-title" data-key="title">{newest.data.title}</p>
                <p class="el-key-desc" data-key="description">{newest.data.description}</p>
                <p class="el-key-meta">
                  <span class="el-key-group" data-key="group">{newest.data.group}</span> · added <span data-key="added">{newest.data.added}</span>
                </p>
                <a class="el-key-open" href={newest.href} target="_blank" rel="noopener" data-key-link>
                  open <span data-key="host">{newest.data.host}</span> ↗<span class="sr-only"> (opens in a new tab)</span>
                </a>
              </div>
            </div>
          </div>
          <ol class="el-cells" role="list">
            {hasCellar && (
              <li class="el-cell" style="--c: 1; --r: 1">
                <a
                  href="/recommended/services/"
                  class="el-face el el-cellar"
                  data-el
                  data-peek={`ls ~/toolbox  # elements 1–${cellarCount}, discovered since ${firstToolYear}`}
                >
                  <span class="el-num">1–{cellarCount}</span>
                  <span class="el-sym">+{cellarCount}</span>
                  <span class="el-name">earlier tools</span>
                </a>
              </li>
            )}
            {elements.map((element) => (
              <li class="el-cell" style={`--c: ${element.col}; --r: ${element.row}`}>
                <a
                  href={element.href}
                  target="_blank"
                  rel="noopener"
                  class="el-face el"
                  style={`--h: ${element.data.hue}`}
                  data-el
                  data-element
                  data-active={element === newest ? "" : undefined}
                  data-peek={`open ${element.data.host}  # element ${element.data.number} · ${element.data.group} · added ${element.data.added}`}
                  {...Object.fromEntries(Object.entries(element.data).map(([key, value]) => [`data-${key}`, value]))}
                >
                  <span class="el-num" aria-hidden="true">
                    {element.data.number}
                  </span>
                  <span class="el-sym" aria-hidden="true">
                    {element.data.symbol}
                  </span>
                  <span class="el-name">{element.data.name}</span>
                  <span class="sr-only">
                    {element.data.description && <>: {element.data.description}</>} (opens in a new tab)
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </div>
        <div class="periodic-foot">
          <ul class="el-legend" aria-label="Element groups">
            {elementGroups.map((group) => (
              <li>
                <a
                  href={`/topics/${group.slug}/tools/`}
                  class="el-group"
                  style={`--h: ${topicHue(group.slug)}`}
                  data-group-filter={group.slug}
                  data-peek={`cd ~/topics/${group.slug}/tools  # ${plural(group.count, "element")} on the table`}
                >
                  <span class="el-swatch" aria-hidden="true" />
                  {group.slug}
                  <span class="opacity-60">{group.count}</span>
                </a>
              </li>
            ))}
          </ul>
          <p class="font-mono text-sm whitespace-nowrap">
            <a href="/recommended/services/" class="text-accent hover:underline">
              all {graph.tools.length} elements →
            </a>
          </p>
        </div>
      </section>
    )
  }

  <section class="shell pb-8" aria-labelledby="graph-title">
    <div class="window graph-teaser">
      <div class="window-bar">
        <span class="window-dots" aria-hidden="true"><span></span><span></span><span></span></span>
        <span>graph.json · {nodes.length} nodes · {links.length} edges</span>
      </div>
      <div class="grid gap-6 p-6 md:grid-cols-[1fr_auto] md:items-center">
        <div>
          <h2 id="graph-title" class="text-2xl font-semibold tracking-tight">Explore the knowledge graph</h2>
          <p class="mt-2 max-w-xl font-serif text-lg text-muted">
            Every post and snippet, wired to the topics it touches. Follow the threads between Azure, Docker, .NET and friends.
          </p>
          <div class="mt-4 flex flex-wrap gap-1.5">
            {topTopics.map((topic) => <TopicToken slug={topic.slug} label={topic.slug} count={topic.totalPosts + topic.totalSnippets} />)}
          </div>
        </div>
        <a href="/graph/" class="btn btn-primary self-start">open graph →</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  /** Periodic table: hovering or focusing an element shows it in the key; legend groups dim the rest. */
  function setupPeriodicTable() {
    const table = document.querySelector<HTMLElement>("[data-periodic]");
    const key = table?.querySelector<HTMLElement>("[data-element-key]");
    if (!table || !key) return;
    const link = key.querySelector<HTMLAnchorElement>("[data-key-link]");
    const fields = [...key.querySelectorAll<HTMLElement>("[data-key]")];
    const elements = [...table.querySelectorAll<HTMLAnchorElement>("[data-element]")];
    const cells = [...table.querySelectorAll<HTMLElement>("[data-el]")];

    const select = (element: HTMLAnchorElement) => {
      if (element.hasAttribute("data-active")) return;
      for (const other of elements) other.toggleAttribute("data-active", other === element);
      for (const field of fields) field.textContent = element.dataset[field.dataset.key ?? ""] ?? "";
      key.style.setProperty("--h", element.dataset.hue ?? "160");
      if (link) link.href = element.href;
    };
    const highlight = (group?: string) => {
      for (const cell of cells) cell.toggleAttribute("data-dim", group !== undefined && cell.dataset.group !== group);
    };

    for (const element of elements) {
      element.addEventListener("pointerenter", () => select(element));
      element.addEventListener("focus", () => select(element));
    }
    for (const filter of table.querySelectorAll<HTMLElement>("[data-group-filter]")) {
      const group = filter.dataset.groupFilter;
      filter.addEventListener("pointerenter", () => highlight(group));
      filter.addEventListener("focus", () => highlight(group));
      filter.addEventListener("pointerleave", () => highlight());
      filter.addEventListener("blur", () => highlight());
    }
  }

  document.addEventListener("astro:page-load", setupPeriodicTable);
</script>

<style>
  /* "now" line: one honest, dated sentence so first-time visitors see the site is alive. */
  .now-line {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.6rem;
    max-width: 36rem;
    margin-top: 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.55;
  }

  .now-dot {
    flex-shrink: 0;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--accent) 22%, transparent);
  }

  .now-meta {
    color: var(--muted);
  }

  .now-meta a {
    color: inherit;
    text-decoration: underline dotted;
    text-underline-offset: 0.2em;
  }

  .now-meta a:hover {
    color: var(--accent);
  }

  /* Hero heatmap: posts and snippets as commits, so the left column carries as much as the desk. */
  .hero-log {
    margin: 2.5rem 0 0;
    max-width: 32rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .hero-log-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    margin-bottom: 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px dashed var(--line);
  }

  .heat {
    display: grid;
    /* Cells share whatever the column leaves, so the grid ends where the heading and footer do. */
    grid-template-columns: 2.4rem repeat(12, minmax(0, 1fr)) 2rem;
    gap: 0.25rem;
    align-items: center;
  }

  @media (max-width: 30rem) {
    .heat {
      grid-template-columns: 2rem repeat(12, minmax(0, 1fr)) 1.6rem;
      gap: 0.2rem;
    }
  }

  .heat-month,
  .heat-year,
  .heat-total {
    font-size: 0.65rem;
    line-height: 1;
    color: var(--muted);
  }

  .heat-month {
    text-align: center;
  }

  .heat-total {
    padding-left: 0.2rem;
    text-align: left;
  }

  .heat-cell {
    position: relative;
    display: block;
    aspect-ratio: 1;
    border-radius: 0.2rem;
    background: var(--sunken);
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--line) 70%, transparent);
    transition:
      scale 120ms ease,
      box-shadow 120ms ease;
  }

  .heat .heat-cell {
    animation: heat-in 0.35s calc(var(--i, 0) * 7ms + 0.2s) cubic-bezier(0.2, 0.9, 0.3, 1.2) backwards;
  }

  .heat-cell[data-level="1"] {
    background: color-mix(in oklab, var(--accent) 28%, var(--surface));
  }

  .heat-cell[data-level="2"] {
    background: color-mix(in oklab, var(--accent) 50%, var(--surface));
  }

  .heat-cell[data-level="3"] {
    background: color-mix(in oklab, var(--accent) 75%, var(--surface));
  }

  .heat-cell[data-level="4"] {
    background: var(--accent);
  }

  .heat-cell:not([data-level="0"]) {
    box-shadow: none;
  }

  .heat-cell[data-future] {
    background: transparent;
    box-shadow: inset 0 0 0 1px var(--line);
    opacity: 0.5;
  }

