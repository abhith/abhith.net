---
import KnowledgeGraph from "@/components/islands/KnowledgeGraph";
import TagToken from "@/components/content/TagToken.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getContentGraph } from "@/lib/content-graph";

const graph = await getContentGraph();
const { nodes, links } = graph.graphData();
const topics = graph.topics.filter((topic) => topic.totalPosts + topic.totalSnippets > 0);
---

<BaseLayout title="Knowledge graph" description="An interactive map of every post and snippet and the topics that connect them." crumbs={[{ label: "graph.json" }]} section="graph">
  <div class="shell pt-8">
    <header class="max-w-3xl">
      <p class="mono-label"><span class="text-accent">$</span> jq '.nodes | length' graph.json → {nodes.length} · edges {links.length}</p>
      <h1 class="mt-2 text-4xl font-bold tracking-tight sm:text-5xl">Knowledge graph</h1>
      <p class="mt-3 font-serif text-lg text-muted">
        Filled circles are topics, outlined circles are posts and snippets. Drag to pan, scroll to zoom, click to open. Keyboard users can use the list beside the graph.
      </p>
    </header>

    <div class="mt-8">
      <KnowledgeGraph client:visible />
    </div>

    <noscript>
      <section class="mt-8">
        <h2 class="section-title">topics</h2>
        <ul class="flex flex-wrap gap-1.5">
          {topics.map((topic) => <li><TagToken slug={topic.slug} count={topic.totalPosts + topic.totalSnippets} /></li>)}
        </ul>
      </section>
    </noscript>
  </div>
</BaseLayout>

<style is:global>
  .kg {
    display: grid;
    gap: 1rem;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: "toolbar" "stage" "list";
  }
  @media (min-width: 64rem) {
    .kg {
      grid-template-columns: minmax(0, 1fr) 16rem;
      grid-template-areas: "toolbar toolbar" "stage list";
    }
  }
  .kg-toolbar {
    grid-area: toolbar;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }
  .kg-search {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: 0.4rem;
    background: var(--surface);
  }
  .kg-search:focus-within {
    border-color: var(--accent);
  }
  .kg-search input {
    font: inherit;
    border: 0;
    outline: none;
    background: transparent;
    color: var(--fg);
    width: 14rem;
  }
  .kg-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--muted);
  }
  .kg-toggle input {
    accent-color: var(--accent);
  }
  .kg-zoom {
    display: inline-flex;
    gap: 0.25rem;
    margin-left: auto;
  }
  .kg-zoom button {
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--line);
    border-radius: 0.375rem;
    background: var(--surface);
    color: var(--fg);
    cursor: pointer;
  }
  .kg-zoom button:hover {
    border-color: var(--accent);
  }
  .kg-stage {
    grid-area: stage;
    position: relative;
    height: min(72vh, 44rem);
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    background:
      radial-gradient(circle at center, color-mix(in oklab, var(--accent) 6%, transparent), transparent 70%),
      var(--surface);
    overflow: hidden;
  }
  .kg-canvas {
    width: 100%;
    height: 100%;
    display: block;
    cursor: grab;
    touch-action: none;
  }
  .kg-tooltip {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    max-width: calc(100% - 1.5rem);
    padding: 0.35rem 0.6rem;
    font-size: 0.85rem;
    border: 1px solid var(--line);
    border-radius: 0.4rem;
    background: var(--bg);
    pointer-events: none;
  }
  .kg-loading {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }
  .kg-list {
    grid-area: list;
  }
  .kg-list ul {
    margin-top: 0.5rem;
    display: grid;
    gap: 0.15rem;
  }
  .kg-list button {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.35rem 0.5rem;
    border: 0;
    border-radius: 0.35rem;
    background: none;
    color: var(--fg);
    font: inherit;
    font-size: 0.9rem;
    text-align: left;
    cursor: pointer;
  }
  .kg-list button:hover,
  .kg-list button:focus-visible {
    background: var(--sunken);
  }
  .kg-list button .mono-label {
    margin-left: auto;
  }
  .kg-dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 999px;
    flex-shrink: 0;
    background: hsl(var(--h) var(--tag-s) var(--tag-l));
  }
</style>
