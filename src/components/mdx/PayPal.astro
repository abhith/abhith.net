---
/** PayPal hosted donate button (same button id as the Gatsby site). */
---

<form action="https://www.paypal.com/cgi-bin/webscr" method="post" target="_top" class="paypal">
  <input type="hidden" name="cmd" value="_s-xclick" />
  <input type="hidden" name="hosted_button_id" value="5UWFDBXNWFXBG" />
  <button type="submit" class="btn btn-primary" title="PayPal - The safer, easier way to pay online!">
    <span aria-hidden="true">♥</span> Donate with PayPal
  </button>
</form>
