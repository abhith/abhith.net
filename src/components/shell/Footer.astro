---
import { SITE } from "@/lib/site";

const year = new Date().getFullYear();
const columns: { title: string; links: { href: string; label: string; me?: boolean; peek?: string }[] }[] = [
  {
    title: "read",
    links: [
      { href: "/blog/", label: "blog" },
      { href: "/snippets/", label: "snippets" },
      { href: "/topics/", label: "topics" },
      { href: "/recommended/", label: "recommended" },
    ],
  },
  {
    title: "follow",
    links: [
      { href: "/blog/rss.xml", label: "rss", peek: "tail -f ~/blog/rss.xml  # follow new posts" },
      { href: SITE.author.url, label: "x", me: true },
      { href: `https://github.com/${SITE.social.github}`, label: "github", me: true },
      { href: "https://www.linkedin.com/in/abhith/", label: "linkedin", me: true },
    ],
  },
  {
    title: "site",
    links: [
      { href: "/about/", label: "about" },
      { href: "/contact/", label: "contact" },
      { href: "/donate/", label: "donate" },
      { href: "/privacy-policy/", label: "privacy" },
    ],
  },
];
---

<footer class="site-footer mt-24 border-t border-line">
  <div class="shell grid gap-8 py-10 sm:grid-cols-[1.5fr_repeat(3,1fr)]">
    <div>
      <p class="flex items-center font-mono text-sm">
        <img src="/img/site/brand/icon.png" alt="" width="20" height="20" class="brand-mark" loading="lazy" decoding="async" />
        <span class="text-accent">~/</span>abhith
      </p>
      <p class="mt-2 max-w-xs text-sm text-muted">{SITE.description}</p>
      <p class="mono-label mt-4">
        © {year} {SITE.author.name} ·{" "}
        <a href={SITE.repo.url} class="underline" data-peek={`git clone ${SITE.repo.url.replace(/^https?:\/\//, "")}`}>source</a>
      </p>
    </div>
    {
      columns.map((column) => (
        <nav aria-label={column.title}>
          <p class="mono-label mb-2">{`# ${column.title}`}</p>
          <ul class="space-y-1 font-mono text-sm">
            {column.links.map((link) => (
              <li>
                <a href={link.href} class="hover:text-accent" rel={link.me ? "me" : undefined} data-peek={link.peek}>
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>
</footer>

<style>
  /* Same tile as the header and favicon, so the page opens and closes on the same mark. */
  .brand-mark {
    width: 1.25rem;
    height: 1.25rem;
    margin-right: 0.5rem;
    border-radius: 0.3rem;
    box-shadow: 0 0 0 1px var(--line);
  }
</style>
